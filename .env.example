# ==============================================================================
# Enterprise IT Support Agentic RAG Copilot - Production Environment Variables
# ==============================================================================

# Application Configuration
APP_NAME=Enterprise IT Support Agentic RAG Copilot
APP_ENV=production
PORT=8080

# Google Gemini API (LLM & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-it-support-rag-gemini
PINECONE_NAMESPACE=company-it-kb

# External Search
TAVILY_API_KEY=your_tavily_api_key_here

# RAG & Routing Behavior
TOP_K=4
MAX_RETRIES=1

# Security & CORS
ADMIN_API_KEY=your-secure-admin-key-here
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080
MAX_UPLOAD_SIZE_MB=25

# Storage & Persistence (Set to persistent disk paths on Render if using a persistent disk)
AUDIT_DB_PATH=data/audit.db
UPLOAD_DIR=uploads
SAMPLE_KB_DIR=data/sample_kb
